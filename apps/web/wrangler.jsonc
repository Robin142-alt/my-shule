{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myshule-web",
  "account_id": "79113628f46775f56ed5f91a0d91a303",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "myshule.online/*", "zone_id": "6826165245e342d8e09a2522bc1834c2" },
    { "pattern": "*.myshule.online/*", "zone_id": "6826165245e342d8e09a2522bc1834c2" }
  ],
  "minify": true,
  "secrets": { "required": ["GATEWAY_IDENTITY_SECRET"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cdn-cgi/*", "/_next/image"]
  },
  "images": { "binding": "IMAGES" },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "vars": {
    "MYSHULE_RUNTIME": "cloudflare",
    "SERVER_API_BASE_URL": "https://my-shule-api-production.up.railway.app",
    "NEXT_PUBLIC_API_BASE_URL": "https://my-shule-api-production.up.railway.app",
    "NEXT_PUBLIC_SITE_URL": "https://www.myshule.online"
  }
}
