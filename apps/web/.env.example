# Public build configuration. Keep API/database/provider secrets on Railway.
NEXT_PUBLIC_SITE_URL=https://www.myshule.online
NEXT_PUBLIC_API_BASE_URL=https://my-shule-api-production.up.railway.app
SERVER_API_BASE_URL=https://my-shule-api-production.up.railway.app
NEXT_PUBLIC_RELEASE_SHA=
MYSHULE_RUNTIME=cloudflare
# Configure GATEWAY_IDENTITY_SECRET with `wrangler secret put` in deployed Workers.
# For local workerd preview use .dev.vars with a test-only value; never NEXT_PUBLIC_*.
