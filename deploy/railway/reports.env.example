# Add these to the existing API environment AND both report worker services.
# Values below are examples only; use Railway's secret variables for credentials.
NODE_ENV=production
REPORT_OBJECT_STORAGE_ENABLED=true
REPORT_OBJECT_STORAGE_PROVIDER=r2
REPORT_OBJECT_STORAGE_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
REPORT_OBJECT_STORAGE_REGION=auto
REPORT_OBJECT_STORAGE_BUCKET=<private-bucket-name>
REPORT_OBJECT_STORAGE_ACCESS_KEY_ID=<bucket-scoped-access-key>
REPORT_OBJECT_STORAGE_SECRET_ACCESS_KEY=<bucket-scoped-secret>

# Keep existing UPLOAD_OBJECT_STORAGE_* settings unchanged for school uploads.
# Retain the existing DATABASE_URL, DATABASE_RUNTIME_ROLE, Redis, authentication,
# school routing, upload signing, and other required production configuration.
DATABASE_API_MAX_CONNECTIONS=20
DATABASE_WORKER_MAX_CONNECTIONS=5

# Worker services only. Deploy the same build twice, once with each lane.
APP_RUNTIME=reports-worker
REPORT_WORKER_LANE=interactive
# REPORT_WORKER_LANE=bulk on the second service.
REPORT_WORKER_CONCURRENCY=1
# Optional separate Redis instance for report workers, recommended at high load.
# REPORT_REDIS_URL=redis://<private-report-redis-address>:6379
# Both lanes must share the same report Redis and queue prefix.
QUEUE_PREFIX=my-shule
