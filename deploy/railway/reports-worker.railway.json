{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build",
    "watchPatterns": ["apps/api/**", "api/**", "prisma/**", "package.json", "package-lock.json", "tsconfig.json", "Dockerfile", ".dockerignore", "deploy/railway/reports-worker.railway.json"]
  },
  "deploy": {
    "startCommand": "node dist/apps/api/src/reports-worker.js",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "overlapSeconds": 5,
    "drainingSeconds": 60
  }
}
