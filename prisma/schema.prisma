  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  @@index([schoolId])
  @@map("fee_items")
}

model StudentFeeAccount {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  school         School           @relation(fields: [schoolId], references: [id])
  studentId      String           @unique @map("student_id")
  student        Student          @relation(fields: [studentId], references: [id])
  openingBalance Float            @default(0) @map("opening_balance")
  currentBalance Float            @default(0) @map("current_balance")
  status         FeeAccountStatus
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  @@index([schoolId])
  @@index([schoolId, studentId, status])
  @@map("student_fee_accounts")
}

model Invoice {
  id             String        @id @default(uuid())
  schoolId       String        @map("school_id")
  school         School        @relation(fields: [schoolId], references: [id])
  studentId      String        @map("student_id")
  student        Student       @relation(fields: [studentId], references: [id])
  academicYearId String        @map("academic_year_id")
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  termId         String        @map("term_id")
  term           Term          @relation(fields: [termId], references: [id])
  invoiceNumber  String        @unique @map("invoice_number")
  amountDue      Float         @map("amount_due")
  amountPaid     Float         @default(0) @map("amount_paid")
  balance        Float
  status         InvoiceStatus
  dueDate        DateTime      @map("due_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  invoiceItems   InvoiceItem[]
  payments       Payment[]

  @@index([schoolId])
  @@index([schoolId, invoiceNumber])
  @@index([schoolId, studentId])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  school      School    @relation(fields: [schoolId], references: [id])
  invoiceId   String    @map("invoice_id")
  invoice     Invoice   @relation(fields: [invoiceId], references: [id])
  feeItemName String    @map("fee_item_name")
  amount      Float
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([schoolId])
  @@map("invoice_items")
}

model Payment {
  id               String        @id @default(uuid())
  schoolId         String        @map("school_id")
  school           School        @relation(fields: [schoolId], references: [id])
  studentId        String        @map("student_id")
  student          Student       @relation(fields: [studentId], references: [id])
  invoiceId        String?       @map("invoice_id")
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id])
  paymentReference String        @unique @map("payment_reference")
  paymentMethod    PaymentMethod @map("payment_method")
  amount           Float
  paymentDate      DateTime      @map("payment_date")
  receivedByUserId String?       @map("received_by_user_id")
  status           PaymentStatus
  remarks          String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  receipts         Receipt[]

  @@index([schoolId])
  @@map("payments")
}

model Receipt {
  id            String        @id @default(uuid())
  schoolId      String        @map("school_id")
  school        School        @relation(fields: [schoolId], references: [id])
  paymentId     String        @map("payment_id")
  payment       Payment       @relation(fields: [paymentId], references: [id])
  receiptNumber String        @unique @map("receipt_number")
  issuedToName  String        @map("issued_to_name")
  amount        Float
  status        ReceiptStatus
  printedAt     DateTime?     @map("printed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  @@index([schoolId])
  @@index([schoolId, receiptNumber])
  @@map("receipts")
}

model MpesaTransaction {
