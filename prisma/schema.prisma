model SchoolMembership {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  school         School           @relation(fields: [schoolId], references: [id])
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id])
  membershipType MembershipType   @map("membership_type")
  status         MembershipStatus
  joinedAt       DateTime         @default(now()) @map("joined_at")
  removedAt      DateTime?        @map("removed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([schoolId, userId])
  @@map("school_memberships")
}

// ==========================================
// 2. Roles & Permissions Schema
// ==========================================
model Role {
  id                  String               @id @default(uuid())
  schoolId            String?              @map("school_id")
  school              School?              @relation(fields: [schoolId], references: [id])
  name                String
  code                String
  type                RoleType             @default(SCHOOL)
  description         String?
  isSystemRole        Boolean              @default(false) @map("is_system_role")
  isCustomRole        Boolean              @default(false) @map("is_custom_role")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@index([schoolId])
  @@map("roles")
}

model Permission {
  id                      String                   @id @default(uuid())
  code                    String                   @unique
  module                  String
  resource                String                   @default("")
  action                  String                   @default("")
  scope                   String                   @default("")
  key                     String                   @unique @default("")
  description             String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]
  modulePermissions       ModulePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  allowed      Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id               String           @id @default(uuid())
  schoolId         String           @map("school_id")
  school           School           @relation(fields: [schoolId], references: [id])
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id])
  roleId           String           @map("role_id")
  role             Role             @relation(fields: [roleId], references: [id])
  scopeType        ScopeType        @map("scope_type")
  scopeId          String?          @map("scope_id")
  assignedByUserId String           @map("assigned_by_user_id")
  status           AssignmentStatus
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  @@index([schoolId])
  @@index([schoolId, userId])
  @@map("user_roles") // Changed from user_role_assignments to user_roles
}

model UserPermissionOverride {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  schoolId     String     @map("school_id")
  school       School     @relation(fields: [schoolId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  allowed      Boolean
  reason       String?
  expiresAt    DateTime?  @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([userId, schoolId, permissionId])
  @@index([userId])
  @@index([schoolId])
  @@map("user_permission_overrides")
}

model ModulePermission {
  id           String     @id @default(uuid())
  moduleCode   String     @map("module_code")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([moduleCode, permissionId])
  @@map("module_permissions")
}

model ApprovalRule {
  id                   String        @id @default(uuid())
  schoolId             String        @map("school_id")
  school               School        @relation(fields: [schoolId], references: [id])
  module               String
  action               String
  description          String?
  requesterRoles       String[]      @map("requester_roles")
  approverRoles        String[]      @map("approver_roles")
  approvalLevel        ApprovalLevel @default(SINGLE) @map("approval_level")
  riskLevel            RiskLevel     @default(MEDIUM) @map("risk_level")
  amountMin            Float?        @map("amount_min")
  amountMax            Float?        @map("amount_max")
  requiresReason       Boolean       @default(false) @map("requires_reason")
  requiresAttachment   Boolean       @default(false) @map("requires_attachment")
  allowSelfApproval    Boolean       @default(false) @map("allow_self_approval")
  escalationRoles      String[]      @map("escalation_roles")
  escalationAfterHours Int?          @map("escalation_after_hours")
  isActive             Boolean       @default(true) @map("is_active")
  createdBy            String?       @map("created_by")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("approval_rules")
}

// ==========================================
// 3. School Setup Schema
// ==========================================
model SchoolSetting {
  id                   String   @id @default(uuid())
  schoolId             String   @unique @map("school_id")
  school               School   @relation(fields: [schoolId], references: [id])
  timezone             String   @default("Africa/Nairobi")
  defaultLanguage      String   @default("en") @map("default_language")
  smsEnabled           Boolean  @default(true) @map("sms_enabled")
  emailEnabled         Boolean  @default(true) @map("email_enabled")
  mpesaEnabled         Boolean  @default(false) @map("mpesa_enabled")
  offlineSyncEnabled   Boolean  @default(false) @map("offline_sync_enabled")
  academicYearRequired Boolean  @default(true) @map("academic_year_required")
  parentPortalEnabled  Boolean  @default(false) @map("parent_portal_enabled")
  studentPortalEnabled Boolean  @default(false) @map("student_portal_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("school_settings")
}

model SchoolModule {
  id         String       @id @default(uuid())
  schoolId   String       @map("school_id")
  school     School       @relation(fields: [schoolId], references: [id])
  moduleCode String       @map("module_code")
  moduleName String       @map("module_name")
  status     ModuleStatus
  enabledAt  DateTime?    @map("enabled_at")
  expiresAt  DateTime?    @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([schoolId, moduleCode])
  @@index([schoolId])
  @@map("school_modules")
}

model SetupChecklistItem {
  id                String          @id @default(uuid())
  schoolId          String          @map("school_id")
  school            School          @relation(fields: [schoolId], references: [id])
  key               String
  title             String
  description       String?
  status            ChecklistStatus
  completedByUserId String?         @map("completed_by_user_id")
  completedAt       DateTime?       @map("completed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([schoolId])
  @@map("setup_checklist_items")
}

// ==========================================
// 4. Academic Structure Schema
// ==========================================
model AcademicYear {
  id                        String                     @id @default(uuid())
  schoolId                  String                     @map("school_id")
  school                    School                     @relation(fields: [schoolId], references: [id])
  name                      String
  startDate                 DateTime                   @map("start_date") @db.Date
  endDate                   DateTime                   @map("end_date") @db.Date
  status                    AcademicYearStatus
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  terms                     Term[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  studentEnrollments        StudentEnrollment[]
  attendanceSessions        AttendanceSession[]
  examCycles                ExamCycle[]
  reportCards               ReportCard[]
  feeStructures             FeeStructure[]
  invoices                  Invoice[]
  boardingAllocations       BoardingAllocation[]
  classTimetableEntries     ClassTimetableEntry[]
  classTeacherAssignments   ClassTeacherAssignment[]   @relation("AcademicYearToClassTeacherAssignment")
  studentClassAssignments   StudentClassAssignment[]   @relation("AcademicYearToStudentClassAssignment")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("academic_years")
}

model Term {
  id                        String                     @id @default(uuid())
  schoolId                  String                     @map("school_id")
  school                    School                     @relation(fields: [schoolId], references: [id])
  academicYearId            String                     @map("academic_year_id")
  academicYear              AcademicYear               @relation(fields: [academicYearId], references: [id])
  name                      String
  termNumber                Int                        @map("term_number")
  startDate                 DateTime                   @map("start_date") @db.Date
  endDate                   DateTime                   @map("end_date") @db.Date
  status                    TermStatus
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  teacherSubjectAssignments TeacherSubjectAssignment[]
  studentEnrollments        StudentEnrollment[]
  attendanceSessions        AttendanceSession[]
  reportCardComments        ReportCardComment[]        @relation("TermToReportCardComment")
  examCycles                ExamCycle[]
  reportCards               ReportCard[]
  feeStructures             FeeStructure[]
  invoices                  Invoice[]
  classTimetableEntries     ClassTimetableEntry[]

  @@unique([schoolId, academicYearId, termNumber])
  @@index([schoolId])
  @@index([schoolId, academicYearId])
  @@map("terms")
}

model Department {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  school    School    @relation(fields: [schoolId], references: [id])
  name      String
  code      String
  hodUserId String?   @map("hod_user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  subjects  Subject[]

  @@index([schoolId])
  @@map("departments")
}

model Class {
  id                        String                     @id @default(uuid())
  schoolId                  String                     @map("school_id")
  school                    School                     @relation(fields: [schoolId], references: [id])
  name                      String
  levelNumber               Int                        @map("level_number")
  educationStage            EducationStage             @map("education_stage")
  curriculumType            CurriculumType             @map("curriculum_type")
  status                    ClassStatus
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  streams                   Stream[]
  classSubjects             ClassSubject[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  students                  Student[]
  studentEnrollments        StudentEnrollment[]
  admissionApplications     AdmissionApplication[]
  attendanceSessions        AttendanceSession[]
  examSubjects              ExamSubject[]
  marksEntries              MarksEntry[]
  reportCards               ReportCard[]
  feeStructures             FeeStructure[]
  computerLabSessions       ComputerLabSession[]
  classTimetableEntries     ClassTimetableEntry[]
  academicLevelId           String?                    @map("academic_level_id")
  academicLevel             AcademicLevel?             @relation(fields: [academicLevelId], references: [id])
  studentClassAssignments   StudentClassAssignment[]
  reportCardComments        ReportCardComment[]        @relation("ClassToReportCardComment")
  academicAssignments       AcademicAssignment[]       @relation("ClassToAcademicAssignment")
  academicResources         AcademicResource[]         @relation("ClassToAcademicResource")
  lessonLogs                LessonLog[]                @relation("ClassToLessonLog")
  classTeacherAssignments   ClassTeacherAssignment[]   @relation("ClassToClassTeacherAssignment")

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Stream {
  id                        String                     @id @default(uuid())
  schoolId                  String                     @map("school_id")
  school                    School                     @relation(fields: [schoolId], references: [id])
  classId                   String                     @map("class_id")
  class                     Class                      @relation(fields: [classId], references: [id])
  name                      String
  capacity                  Int?
  classTeacherUserId        String?                    @map("class_teacher_user_id")
  gradeMasterUserId         String?                    @map("grade_master_user_id")
  status                    StreamStatus
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  teacherSubjectAssignments TeacherSubjectAssignment[]
  students                  Student[]
  studentEnrollments        StudentEnrollment[]
  attendanceSessions        AttendanceSession[]
  marksEntries              MarksEntry[]
  reportCards               ReportCard[]
  computerLabSessions       ComputerLabSession[]
  classTimetableEntries     ClassTimetableEntry[]
  studentClassAssignments   StudentClassAssignment[]

  @@unique([schoolId, classId, name])
  @@index([schoolId])
  @@index([schoolId, classId])
  @@map("streams")
}

model Subject {
  id                        String                     @id @default(uuid())
  schoolId                  String                     @map("school_id")
  school                    School                     @relation(fields: [schoolId], references: [id])
  departmentId              String?                    @map("department_id")
  department                Department?                @relation(fields: [departmentId], references: [id])
  name                      String
  code                      String
  curriculumType            CurriculumType             @map("curriculum_type")
  isCompulsory              Boolean                    @default(false) @map("is_compulsory")
  status                    SubjectStatus
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  deletedAt                 DateTime?                  @map("deleted_at")
  classSubjects             ClassSubject[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  examSubjects              ExamSubject[]
  marksEntries              MarksEntry[]
  computerLabSessions       ComputerLabSession[]
  classTimetableEntries     ClassTimetableEntry[]

  @@index([schoolId])
  @@map("subjects")
}

model ClassSubject {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  school       School    @relation(fields: [schoolId], references: [id])
  classId      String    @map("class_id")
  class        Class     @relation(fields: [classId], references: [id])
  subjectId    String    @map("subject_id")
  subject      Subject   @relation(fields: [subjectId], references: [id])
  isCompulsory Boolean   @default(false) @map("is_compulsory")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@unique([schoolId, classId, subjectId])
  @@index([schoolId])
  @@map("class_subjects")
}

model TeacherSubjectAssignment {
  id               String                  @id @default(uuid())
  schoolId         String                  @map("school_id")
  school           School                  @relation(fields: [schoolId], references: [id])
  teacherUserId    String                  @map("teacher_user_id")
  academicYearId   String                  @map("academic_year_id")
  academicYear     AcademicYear            @relation(fields: [academicYearId], references: [id])
  termId           String?                 @map("term_id")
  term             Term?                   @relation(fields: [termId], references: [id])
  classId          String                  @map("class_id")
  class            Class                   @relation(fields: [classId], references: [id])
  streamId         String?                 @map("stream_id")
  stream           Stream?                 @relation(fields: [streamId], references: [id])
  subjectId        String                  @map("subject_id")
  subject          Subject                 @relation(fields: [subjectId], references: [id])
  assignedByUserId String                  @map("assigned_by_user_id")
  status           TeacherAssignmentStatus
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")

  @@index([schoolId])
  @@index([schoolId, teacherUserId])
  @@index([schoolId, classId])
  @@map("teacher_subject_assignments")
}

// ==========================================
// 5. Student and Parent Schema
// ==========================================
model Student {
  id                          String                       @id @default(uuid())
  schoolId                    String                       @map("school_id")
  school                      School                       @relation(fields: [schoolId], references: [id])
  admissionNumber             String                       @map("admission_number")
  upiNumber                   String?                      @map("upi_number")
  nemisNumber                 String?                      @map("nemis_number")
  firstName                   String                       @map("first_name")
  middleName                  String?                      @map("middle_name")
  lastName                    String                       @map("last_name")
  gender                      String
  dateOfBirth                 DateTime                     @map("date_of_birth") @db.Date
  photoUrl                    String?                      @map("photo_url")
  birthCertificateNumber      String?                      @map("birth_certificate_number")
  nationality                 String
  religion                    String?
  studentStatus               StudentStatus                @map("student_status")
  admissionDate               DateTime                     @map("admission_date") @db.Date
  currentClassId              String?                      @map("current_class_id")
  currentClass                Class?                       @relation(fields: [currentClassId], references: [id])
  currentStreamId             String?                      @map("current_stream_id")
  currentStream               Stream?                      @relation(fields: [currentStreamId], references: [id])
  boardingStatus              BoardingStatus               @map("boarding_status")
  medicalNotesSummary         String?                      @map("medical_notes_summary")
  primaryGuardianName         String?                      @map("primary_guardian_name")
  primaryGuardianPhone        String?                      @map("primary_guardian_phone")
  metadata                    Json?                        @default("{}")
  createdByUserId             String?                      @map("created_by_user_id")
  updatedByUserId             String?                      @map("updated_by_user_id")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")
  studentGuardians            StudentGuardian[]
  studentEnrollments          StudentEnrollment[]
  attendanceRecords           AttendanceRecord[]
  marksEntries                MarksEntry[]
  reportCards                 ReportCard[]
  studentFeeAccount           StudentFeeAccount?
  invoices                    Invoice[]
  payments                    Payment[]
  feeWaivers                  FeeWaiver[]
  disciplineCases             DisciplineCase[]
  counsellingCases            CounsellingCase[]
  medicalVisits               MedicalVisit[]
  libraryLoans                LibraryLoan[]
  libraryFines                LibraryFine[]
  computerLabUsageLogs        ComputerLabUsageLog[]
  boardingAllocations         BoardingAllocation[]
  boardingAttendances         BoardingAttendance[]
  studentTransportAssignments StudentTransportAssignment[]

  studentClassAssignments StudentClassAssignment[] @relation("StudentToStudentClassAssignment")
  reportCardComments      ReportCardComment[]      @relation("StudentToReportCardComment")
  studentNotes            StudentNote[]            @relation("StudentToStudentNote")
  parentMeetings          ParentMeeting[]          @relation("StudentToParentMeeting")
  classRequests           ClassRequest[]           @relation("StudentToClassRequest")
  studentExitRecords      StudentExitRecord[]
  studentClearances       StudentClearance[]
  studentAuditLogs        StudentAuditLog[]
  studentCommunications   StudentCommunication[]
  welfareConcerns         WelfareConcern[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, upiNumber])
  @@unique([schoolId, nemisNumber])
  @@index([schoolId])
  @@index([schoolId, currentClassId])
  @@map("students")
}

model ParentGuardian {
  id                    String                 @id @default(uuid())
  schoolId              String                 @map("school_id")
  school                School                 @relation(fields: [schoolId], references: [id])
  fullName              String                 @map("full_name")
  relationshipType      GuardianRelationship   @map("relationship_type")
  phone                 String
  email                 String?
  idNumber              String?                @map("id_number")
  occupation            String?
  address               String?
  status                GuardianStatus
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  studentGuardians      StudentGuardian[]
  studentCommunications StudentCommunication[]

  @@unique([schoolId, phone])
  @@index([schoolId])
  @@map("parent_guardians")
}

model StudentGuardian {
  id                    String               @id @default(uuid())
  schoolId              String               @map("school_id")
  school                School               @relation(fields: [schoolId], references: [id])
  studentId             String               @map("student_id")
  student               Student              @relation(fields: [studentId], references: [id])
  guardianId            String               @map("guardian_id")
  guardian              ParentGuardian       @relation(fields: [guardianId], references: [id])
  relationshipType      GuardianRelationship @map("relationship_type")
  isPrimaryContact      Boolean              @default(false) @map("is_primary_contact")
  canReceiveSms         Boolean              @default(true) @map("can_receive_sms")
  canAccessParentPortal Boolean              @default(false) @map("can_access_parent_portal")
  canPickStudent        Boolean              @default(false) @map("can_pick_student")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  deletedAt             DateTime?            @map("deleted_at")

  @@unique([schoolId, studentId, guardianId])
  @@index([schoolId])
  @@index([schoolId, studentId])
  @@map("student_guardians")
}

model StudentEnrollment {
  id               String           @id @default(uuid())
  schoolId         String           @map("school_id")
  school           School           @relation(fields: [schoolId], references: [id])
  studentId        String           @map("student_id")
  student          Student          @relation(fields: [studentId], references: [id])
  academicYearId   String           @map("academic_year_id")
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  termId           String?          @map("term_id")
  term             Term?            @relation(fields: [termId], references: [id])
  classId          String           @map("class_id")
  class            Class            @relation(fields: [classId], references: [id])
  streamId         String           @map("stream_id")
  stream           Stream           @relation(fields: [streamId], references: [id])
  enrollmentStatus EnrollmentStatus @map("enrollment_status")
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@index([schoolId, academicYearId])
  @@map("student_enrollments")
}

// ==========================================
// 6. Admissions Schema
// ==========================================
model AdmissionApplication {
  id                     String               @id @default(uuid())
  schoolId               String               @map("school_id")
  school                 School               @relation(fields: [schoolId], references: [id])
  applicationNumber      String               @map("application_number")
  firstName              String               @map("first_name")
  middleName             String?              @map("middle_name")
  lastName               String               @map("last_name")
  gender                 String
  dateOfBirth            DateTime             @map("date_of_birth") @db.Date
  applyingForClassId     String               @map("applying_for_class_id")
  applyingForClass       Class                @relation(fields: [applyingForClassId], references: [id])
  guardianName           String               @map("guardian_name")
  guardianPhone          String               @map("guardian_phone")
  guardianEmail          String?              @map("guardian_email")
  guardianOccupation     String?              @map("guardian_occupation")
  guardianRelationship   String?              @map("guardian_relationship")
  previousSchool         String?              @map("previous_school")
  applicationStatus      ApplicationStatus    @map("application_status")
  submittedAt            DateTime             @map("submitted_at")
  reviewedByUserId       String?              @map("reviewed_by_user_id")
  kcpeResults            String?              @map("kcpe_results")
  cbcLevel               String?              @map("cbc_level")
  nemisUpi               String?              @map("nemis_upi")
  allergies              String?
  conditions             String?
  emergencyContact       String?              @map("emergency_contact")
  birthCertificateNumber String?              @map("birth_certificate_number")
  nationality            String?              @default("Kenyan")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  admissionDocuments     AdmissionDocument[]
  admissionInterviews    AdmissionInterview[]

  @@index([schoolId])
  @@map("admission_applications")
}

model AdmissionDocument {
  id               String               @id @default(uuid())
  schoolId         String               @map("school_id")
  school           School               @relation(fields: [schoolId], references: [id])
  applicationId    String               @map("application_id")
  application      AdmissionApplication @relation(fields: [applicationId], references: [id])
  documentType     DocumentType         @map("document_type")
  fileUrl          String               @map("file_url")
  status           DocumentStatus
  verifiedByUserId String?              @map("verified_by_user_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  @@index([schoolId])
  @@map("admission_documents")
}

model AdmissionInterview {
  id                String               @id @default(uuid())
  schoolId          String               @map("school_id")
  school            School               @relation(fields: [schoolId], references: [id])
  applicationId     String               @map("application_id")
  application       AdmissionApplication @relation(fields: [applicationId], references: [id])
  scheduledAt       DateTime             @map("scheduled_at")
  interviewerUserId String               @map("interviewer_user_id")
  score             Float?
  remarks           String?
  status            InterviewStatus
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  @@index([schoolId])
  @@map("admission_interviews")
}

// ==========================================
// 7. Attendance Schema
// ==========================================
model AttendanceSession {
  id                String                  @id @default(uuid())
  schoolId          String                  @map("school_id")
  school            School                  @relation(fields: [schoolId], references: [id])
  academicYearId    String                  @map("academic_year_id")
  academicYear      AcademicYear            @relation(fields: [academicYearId], references: [id])
  termId            String                  @map("term_id")
  term              Term                    @relation(fields: [termId], references: [id])
  classId           String                  @map("class_id")
  class             Class                   @relation(fields: [classId], references: [id])
  streamId          String                  @map("stream_id")
  stream            Stream                  @relation(fields: [streamId], references: [id])
  date              DateTime                @db.Date
  sessionType       SessionType             @map("session_type")
  takenByUserId     String                  @map("taken_by_user_id")
  status            AttendanceSessionStatus
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  deletedAt         DateTime?               @map("deleted_at")
  attendanceRecords AttendanceRecord[]

  @@unique([schoolId, classId, streamId, date, sessionType])
  @@index([schoolId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(uuid())
  schoolId            String            @map("school_id")
  school              School            @relation(fields: [schoolId], references: [id])
  attendanceSessionId String            @map("attendance_session_id")
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id])
  studentId           String            @map("student_id")
  student             Student           @relation(fields: [studentId], references: [id])
  status              AttendanceStatus
  remarks             String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")

  @@unique([schoolId, attendanceSessionId, studentId])
  @@index([schoolId])
  @@index([schoolId, studentId])
  @@map("attendance_records")
}

// ==========================================
// 8. Exams, Assessments & Report Cards
// ==========================================
model ExamCycle {
  id              String          @id @default(uuid())
  schoolId        String          @map("school_id")
  school          School          @relation(fields: [schoolId], references: [id])
  academicYearId  String          @map("academic_year_id")
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  termId          String          @map("term_id")
  term            Term            @relation(fields: [termId], references: [id])
  name            String
  examType        ExamType        @map("exam_type")
  status          ExamCycleStatus
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  examSubjects    ExamSubject[]
  marksEntries    MarksEntry[]
  reportCards     ReportCard[]

  @@index([schoolId])
  @@index([schoolId, academicYearId])
  @@map("exam_cycles")
}

model ExamSubject {
  id             String            @id @default(uuid())
  schoolId       String            @map("school_id")
  school         School            @relation(fields: [schoolId], references: [id])
  examCycleId    String            @map("exam_cycle_id")
  examCycle      ExamCycle         @relation(fields: [examCycleId], references: [id])
  classId        String            @map("class_id")
  class          Class             @relation(fields: [classId], references: [id])
  subjectId      String            @map("subject_id")
  subject        Subject           @relation(fields: [subjectId], references: [id])
  maxMarks       Float             @map("max_marks")
  gradingScaleId String?           @map("grading_scale_id")
  gradingScale   GradingScale?     @relation(fields: [gradingScaleId], references: [id])
  status         ExamSubjectStatus
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  @@index([schoolId])
  @@map("exam_subjects")
}

model MarksEntry {
  id            String           @id @default(uuid())
  schoolId      String           @map("school_id")
  school        School           @relation(fields: [schoolId], references: [id])
  examCycleId   String           @map("exam_cycle_id")
  examCycle     ExamCycle        @relation(fields: [examCycleId], references: [id])
  studentId     String           @map("student_id")
  student       Student          @relation(fields: [studentId], references: [id])
  classId       String           @map("class_id")
  class         Class            @relation(fields: [classId], references: [id])
  streamId      String           @map("stream_id")
  stream        Stream           @relation(fields: [streamId], references: [id])
  subjectId     String           @map("subject_id")
