// ==========================================
// 1. Core Platform Tables
// ==========================================
model User {
  id                      String                   @id @default(uuid())
  fullName                String                   @map("full_name")
  email                   String                   @unique
  phone                   String?                  @unique
  passwordHash            String                   @map("password_hash")
  avatarUrl               String?                  @map("avatar_url")
  status                  UserStatus
  lastLoginAt             DateTime?                @map("last_login_at")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  phoneVerifiedAt         DateTime?                @map("phone_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")
  schoolMemberships       SchoolMembership[]
  userRoleAssignments     UserRoleAssignment[]
  userPermissionOverrides UserPermissionOverride[]
  communicationBroadcasts CommunicationBroadcast[]

  @@map("users")
}

model School {
  id                          String                       @id @default(uuid())
  schoolCode                  String                       @unique @map("school_code")
  name                        String
  slug                        String                       @unique
  registrationNumber          String?                      @unique @map("registration_number")
  kraPin                      String?                      @map("kra_pin")
  schoolType                  SchoolType                   @map("school_type")
  ownershipType               OwnershipType                @map("ownership_type")
  curriculumMode              CurriculumMode               @map("curriculum_mode")
  county                      String?
  subCounty                   String?                      @map("sub_county")
  ward                        String?
  address                     String?
  phone                       String?
  email                       String?
  logoUrl                     String?                      @map("logo_url")
  motto                       String?
  status                      SchoolStatus
  isDemoSchool                Boolean                      @default(false) @map("is_demo_school")
  createdByUserId             String                       @map("created_by_user_id")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")
  schoolMemberships           SchoolMembership[]
  roles                       Role[]
  userRoleAssignments         UserRoleAssignment[]
  schoolSetting               SchoolSetting?
  schoolModules               SchoolModule[]
  setupChecklistItems         SetupChecklistItem[]
  academicYears               AcademicYear[]
  terms                       Term[]
  departments                 Department[]
  classes                     Class[]
  streams                     Stream[]
  subjects                    Subject[]
  classSubjects               ClassSubject[]
  teacherSubjectAssignments   TeacherSubjectAssignment[]
  students                    Student[]
  parentGuardians             ParentGuardian[]
  studentGuardians            StudentGuardian[]
  studentEnrollments          StudentEnrollment[]
  admissionApplications       AdmissionApplication[]
  admissionDocuments          AdmissionDocument[]
  admissionInterviews         AdmissionInterview[]
  attendanceSessions          AttendanceSession[]
  attendanceRecords           AttendanceRecord[]
  examCycles                  ExamCycle[]
  examSubjects                ExamSubject[]
  marksEntries                MarksEntry[]
  gradingScales               GradingScale[]
  gradingScaleRanges          GradingScaleRange[]
  reportCards                 ReportCard[]
  feeStructures               FeeStructure[]
  feeItems                    FeeItem[]
  studentFeeAccounts          StudentFeeAccount[]
  invoices                    Invoice[]
  invoiceItems                InvoiceItem[]
  payments                    Payment[]
  receipts                    Receipt[]
  mpesaTransactions           MpesaTransaction[]
  feeWaivers                  FeeWaiver[]
  notificationTemplates       NotificationTemplate[]
  notifications               Notification[]
  smsLogs                     SmsLog[]
  approvalRequests            ApprovalRequest[]
  workflowTasks               WorkflowTask[]
  disciplineCases             DisciplineCase[]
  disciplineActions           DisciplineAction[]
  counsellingCases            CounsellingCase[]
  counsellingSessions         CounsellingSession[]
  medicalVisits               MedicalVisit[]
  medicineInventories         MedicineInventory[]
  medicineDispensingLogs      MedicineDispensingLog[]
  libraryBooks                LibraryBook[]
  libraryBookCopies           LibraryBookCopy[]
  libraryLoans                LibraryLoan[]
  libraryFines                LibraryFine[]
  inventoryCategories         InventoryCategory[]
  inventoryItems              InventoryItem[]
  inventoryStockMovements     InventoryStockMovement[]
  inventoryRequests           InventoryRequest[]
  inventoryRequestItems       InventoryRequestItem[]
  suppliers                   Supplier[]
  purchaseRequests            PurchaseRequest[]
  purchaseOrders              PurchaseOrder[]
  assets                      Asset[]
  assetMovements              AssetMovement[]
  maintenanceTickets          MaintenanceTicket[]
  computerLabPcs              ComputerLabPc[]
  computerLabSessions         ComputerLabSession[]
