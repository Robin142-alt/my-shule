// 11. Approvals & Workflow Tasks
// ==========================================
model ApprovalRequest {
  id                   String         @id @default(uuid())
  schoolId             String         @map("school_id")
  school               School         @relation(fields: [schoolId], references: [id])
  ruleId               String         @map("rule_id")
  module               String
  action               String
  targetEntityType     String         @map("target_entity_type")
  targetEntityId       String         @map("target_entity_id")
  requestedByUserId    String         @map("requested_by_user_id")
  assignedApproverId   String?        @map("assigned_approver_id")
  assignedApproverRole String?        @map("assigned_approver_role")
  status               ApprovalStatus @default(DRAFT)
  reason               String?
  requesterComment     String?        @map("requester_comment")
  approverComment      String?        @map("approver_comment")
  oldValue             Json?          @map("old_value")
  newValue             Json?          @map("new_value")
  attachments          String[]
  submittedAt          DateTime?      @map("submitted_at")
  approvedAt           DateTime?      @map("approved_at")
  rejectedAt           DateTime?      @map("rejected_at")
  escalatedAt          DateTime?      @map("escalated_at")
  cancelledAt          DateTime?      @map("cancelled_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  auditLogs ApprovalAuditLog[]

  @@index([schoolId])
  @@map("approval_requests")
}

model ApprovalAuditLog {
  id             String          @id @default(uuid())
  schoolId       String          @map("school_id")
  requestId      String          @map("request_id")
  request        ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId         String          @map("user_id")
  action         String // e.g., SUBMITTED, APPROVED, REJECTED, ESCALATED, COMMENT_ADDED
  comment        String?
  previousStatus ApprovalStatus? @map("previous_status")
  newStatus      ApprovalStatus? @map("new_status")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([schoolId])
  @@index([requestId])
  @@map("approval_audit_logs")
}

model WorkflowTask {
